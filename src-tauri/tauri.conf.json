{
 "$schema": "https://schema.tauri.app/config/2",
 "app": {
  "security": {
   "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost"
  },
  "windows": [
   {
    "label": "main",
    "title": "FlickCut",
    "width": 1280,
    "height": 800,
    "minWidth": 960,
    "minHeight": 600,
    "visible": false
   },
   {
    "label": "control-bar",
    "title": "FlickCut",
    "width": 430,
    "height": 72,
    "decorations": false,
    "transparent": true,
    "alwaysOnTop": true,
    "skipTaskbar": true,
    "resizable": false,
    "maximizable": false,
    "minimizable": false,
    "focus": false
   }
  ]
 },
 "build": {
  "beforeBuildCommand": {
   "cwd": "../frontend-spike",
   "script": "npm run build"
  },
  "beforeDevCommand": {
   "cwd": "../frontend-spike",
   "script": "npm run dev"
  },
  "devUrl": "http://localhost:1420",
  "frontendDist": "../frontend-spike/dist"
 },
 "bundle": {
  "active": true,
  "category": "Video",
  "createUpdaterArtifacts": true,
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png",
   "icons/icon.icns",
   "icons/icon.ico"
  ],
  "linux": {
   "appimage": {
    "bundleMediaFramework": true
   }
  },
  "longDescription": "FlickCut records your gameplay and automatically applies edits on exciting moments: slow motion, speed curves, zoom in and out.",
  "macOS": {
   "minimumSystemVersion": "10.15"
  },
  "shortDescription": "Gaming screen recorder with automatic highlight edits",
  "targets": "all",
  "windows": {
   "nsis": {
    "installMode": "both"
   },
   "webviewInstallMode": {
    "silent": true,
    "type": "downloadBootstrapper"
   }
  }
 },
 "identifier": "com.flickcut.app",
 "plugins": {
  "updater": {
   "active": true,
   "endpoints": [
    "https://github.com/thaarfknight-star/FlickCut/releases/latest/download/latest.json"
   ],
   "pubkey": "REPLACE_ME_BEFORE_FIRST_RELEASE_BUILD: run `tauri signer generate -w ~/.tauri/flickcut.key` and paste the public key here"
  }
 },
 "productName": "FlickCut",
 "version": "0.1.0"
}